{
  "name": "bridgerator",
  "version": "1.1.15",
  "description": "Connect ChatGPT to your Windows PC: files, search and terminal through an outbound-only bridge with folder limits. No inbound ports, no admin rights.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bridgerator": "src/cli.mjs"
  },
  "files": [
    "src",
    "vendor",
    "assets",
    "ui",
    "recipes",
    "install.ps1",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.mjs run",
    "test": "node --test \"test/*.test.mjs\" test/e2e-local.mjs",
    "test:stress": "node --test \"test/stress/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bridgerator-engine": "npm:@wonderwhy-er/desktop-commander@0.2.52",
    "ws": "^8.20.0"
  },
  "homepage": "https://bridgerator.recondeck.com",
  "keywords": [
    "chatgpt",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "windows",
    "chatgpt-connector",
    "ai-assistant",
    "remote-files",
    "powershell",
    "openai",
    "apps-sdk",
    "desktop-automation",
    "local-files",
    "bridge"
  ],
  "bugs": {
    "url": "https://bridgerator.recondeck.com/support"
  },
  "author": "Bridgerator <info@recondeck.com>"
}
