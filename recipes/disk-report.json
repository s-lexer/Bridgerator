{
  "id": "disk-report",
  "title": { "en": "Disk space report", "ru": "Отчёт о месте на диске" },
  "description": {
    "en": "Free space on every local disk, the biggest folders and files inside a folder (your user folder by default; folders excluded on this PC and Bridgerator's own are skipped). OutFile = also save the report to this .txt file (an existing file is kept: the report gets a free name).",
    "ru": "Свободное место на каждом локальном диске, самые большие папки и файлы внутри папки (по умолчанию — папка пользователя; исключённые на этом ПК папки и папки Bridgerator пропускаются). OutFile — также сохранить отчёт в этот .txt-файл (существующий файл не трогается: отчёт получает свободное имя)."
  },
  "params": [
    { "name": "Folder", "type": "path", "default": "%USERPROFILE%", "access": "read", "mustExist": true, "description": { "en": "Folder to look into", "ru": "Какую папку смотреть" }, "tree": "skip" },
    { "name": "Top", "type": "int", "default": 15, "min": 5, "max": 50, "description": { "en": "How many folders and files to list", "ru": "Сколько папок и файлов показать" } },
    { "name": "OutFile", "type": "path", "access": "write", "ext": ".txt", "description": { "en": "Also save the report here (.txt)", "ru": "Также сохранить отчёт сюда (.txt)" } }
  ],
  "schedule": { "type": "weekly", "days": ["fri"], "time": "12:00" },
  "script": [
    "$lines = New-Object System.Collections.Generic.List[string]",
    "$lines.Add('Disk space report, ' + (Get-Date).ToString('yyyy-MM-dd HH:mm'))",
    "foreach ($d in @(Get-CimInstance Win32_LogicalDisk -Filter 'DriveType=3')) {",
    "  $lines.Add(('{0}  {1:N1} GB free of {2:N1} GB ({3:N0}% free)' -f $d.DeviceID, ($d.FreeSpace / 1GB), ($d.Size / 1GB), (100 * $d.FreeSpace / [math]::Max(1.0, [double]$d.Size))))",
    "}",
    "# \"C:\\\" stays \"C:\\\" (\"C:\" alone would be the current folder of drive C).",
    "$root = $P.Folder.TrimEnd('\\')",
    "if ($root -match '^[A-Za-z]:$') { $root += '\\' }",
    "$base = $root.TrimEnd('\\') + '\\'",
    "# FolderSkip: \"<depth>:<hash>\" of excluded folders below Folder (their names are never in the script).",
    "$skip = New-Object 'System.Collections.Generic.HashSet[string]'",
    "$depths = New-Object 'System.Collections.Generic.HashSet[int]'",
    "foreach ($s in @($P.FolderSkip)) { if ($s) { [void]$skip.Add($s); [void]$depths.Add([int]$s.Split(':')[0]) } }",
    "$sha = [Security.Cryptography.SHA256]::Create()",
    "function Test-Skip([string]$rel) { $d = $rel.Split('\\').Count; if (-not $depths.Contains($d)) { return $false }; $h = [BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($rel.ToLowerInvariant())), 0, 8).Replace('-', '').ToLowerInvariant(); return $skip.Contains([string]$d + ':' + $h) }",
    "# Own walk: excluded folders and junctions / symbolic links are never entered.",
    "$all = New-Object System.Collections.Generic.List[object]",
    "$stack = New-Object System.Collections.Generic.Stack[string]",
    "$stack.Push($root)",
    "while ($stack.Count) {",
    "  foreach ($c in @(Get-ChildItem -LiteralPath $stack.Pop() -Force -ErrorAction SilentlyContinue)) {",
    "    if ($c.Attributes -band [IO.FileAttributes]::ReparsePoint) { continue }",
    "    if ($c.PSIsContainer) { if (-not (Test-Skip ($c.FullName.Substring([math]::Min($c.FullName.Length, $base.Length))))) { $stack.Push($c.FullName) }; continue }",
    "    # An excluded FILE (.npmrc, .git-credentials, …) is never listed either.",
    "    if (-not (Test-Skip ($c.FullName.Substring([math]::Min($c.FullName.Length, $base.Length))))) { $all.Add($c) }",
    "  }",
    "}",
    "$groups = @{}",
    "foreach ($f in $all) {",
    "  $rel = $f.FullName.Substring([math]::Min($f.FullName.Length, $base.Length))",
    "  $i = $rel.IndexOf('\\')",
    "  $k = if ($i -ge 0) { $rel.Substring(0, $i) } else { '(files directly here)' }",
    "  $groups[$k] = [double]$groups[$k] + $f.Length",
    "}",
    "$lines.Add('')",
    "$lines.Add('Biggest folders in ' + $root + ':')",
    "$groups.GetEnumerator() | Sort-Object Value -Descending | Select-Object -First $P.Top | ForEach-Object { $lines.Add(('{0,12:N1} MB  {1}' -f ($_.Value / 1MB), $_.Key)) }",
    "$lines.Add('')",
    "$lines.Add('Biggest files:')",
    "$all | Sort-Object Length -Descending | Select-Object -First $P.Top | ForEach-Object { $lines.Add(('{0,12:N1} MB  {1}' -f ($_.Length / 1MB), $_.FullName)) }",
    "if ($P.OutFile) {",
    "  # Never over an existing file: \"report.txt\" → \"report (2).txt\" …",
    "  $out = $P.OutFile; $n = 2",
    "  while ((Test-Path -LiteralPath $out) -and $n -lt 1000) { $out = Join-Path ([IO.Path]::GetDirectoryName($P.OutFile)) ([IO.Path]::GetFileNameWithoutExtension($P.OutFile) + ' (' + $n + ')' + [IO.Path]::GetExtension($P.OutFile)); $n++ }",
    "  $fs = New-Object IO.FileStream($out, [IO.FileMode]::CreateNew)",
    "  try { $w = New-Object IO.StreamWriter($fs, (New-Object Text.UTF8Encoding $true)); foreach ($l in $lines) { $w.WriteLine($l) }; $w.Flush() } finally { $fs.Dispose() }",
    "  $lines.Add(''); $lines.Add('Saved to ' + $out)",
    "}",
    "$lines | ForEach-Object { Write-Output $_ }",
    "exit 0"
  ]
}
